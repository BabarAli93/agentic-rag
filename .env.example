OPENAI_API_KEY=your-openai-api-key
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agentic_rag

LANGSMITH_API_KEY=your-langsmith-api-key
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=agentic-rag

# Local vLLM servers
VLLM_API_KEY=your-vllm-api-key (see vllm configurations in the README)
VLLM_BASE_URL=http://public-ip:8000/v1
VLLM_EMBEDDING_BASE_URL=http://public-ip:8001/v1

DEPLOYMENT_MODE=remote

OPENAI_MODEL_NAME=gpt-4o-mini
LOCAL_MODEL_NAME=qwen2.5:0.5b
VLLM_MODEL_NAME=Qwen/Qwen3-14B

LOCAL_EMBED_MODEL=BAAI/bge-large-en-v1.5
OPENAI_EMBED_MODEL=text-embedding-3-small
VLLM_EMBED_MODEL=BAAI/bge-large-en-v1.5